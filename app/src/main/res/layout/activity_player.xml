<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/player_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/infoNumber"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.Title"
            android:textColor="@color/accent" />

        <ImageView
            android:id="@+id/infoLogo"
            android:layout_width="96dp"
            android:layout_height="64dp"
            android:layout_marginEnd="20dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_channel_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/Text.Title" />

            <TextView
                android:id="@+id/nowEpg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/Text.Caption" />

            <TextView
                android:id="@+id/nowGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/Text.Caption" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
